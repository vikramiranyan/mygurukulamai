# Local self-hosted stack. Copy to backend/.env; never commit backend/.env.
POSTGRES_DB=gurukulam
POSTGRES_USER=gurukulam
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://gurukulam:change-this-local-password@localhost:5432/gurukulam
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
JWT_SECRET=generate-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173,https://vikramiranyan.github.io
JWT_EXPIRE_MINUTES=60
AUTO_CREATE_SCHEMA=false

# Server-only GitHub registry settings. Never expose these as VITE_* variables.
GITHUB_TOKEN=replace-with-a-fine-grained-token-with-contents-write-access
GITHUB_REPOSITORY=vikramiranyan/mygurukulamai
GITHUB_DRIVE_REGISTRY_PATH=data/drive-access-users.json
GITHUB_BRANCH=main
DRIVE_REGISTRY_HMAC_SECRET=generate-another-long-random-secret
